# worker local store + generation output
services/worker/data/
out/
node_modules/
services/ui/dist/

# heavyweight regenerable fixture binary (CMYK TIFF, ~7MB) — recreate with
# services/worker/examples/harvest-edit/gen_assets.py
services/worker/examples/harvest-edit/assets/edge-cases/*.tif
